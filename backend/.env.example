# Copy to .env and replace the empty password with a generated local value.
# This file contains no working credentials.
POSTGRES_USER=fluke
POSTGRES_DB=fluke
POSTGRES_PASSWORD=
# Replace this value with postgresql://fluke:<password>@127.0.0.1:5432/fluke.
# URL-encode special characters in the URL password (or use a hex password).
FLUKE_DATABASE_URL=
# Required for signing API bearer tokens. Generate with `openssl rand -hex 32`.
FLUKE_JWT_SECRET=
# Optional JSON list of exact development origins, e.g. ["http://localhost:4200"].
FLUKE_DEVELOPMENT_ORIGINS=[]
# Optional for PostgreSQL integration tests. Must target the local postgres
# maintenance database, never the application database. Tests create and drop
# their own randomly named databases under this server.
FLUKE_TEST_ADMIN_URL=
